---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStaticPaths } from "./[tag].astro";
const pageTitle = "Tag Index";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="tags">  
  {
    (await getStaticPaths()).map((tagData: any) => (
          <p class="tag"><a href={`/tags/${tagData.params.tag}/`}>{tagData.params.tag}</a></p>
    ))
  }
  </div>
</BaseLayout>
<style>
  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>
