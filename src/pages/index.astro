---
import BaseLayout from "../layouts/BaseLayout.astro";
import Greetings from "../components/Greetings.jsx";
const pageTitle = "Home Page";
---

<BaseLayout pageTitle={pageTitle}>
  <h2>My awesome blog subtitle</h2>
  <Greetings
    client:load
    messages={[
      "Hello",
      "Hi",
      "Welcome",
      "Greetings",
      "Hej",
      "Hallo",
      "Hola",
      "Habari",
    ]}
  />
</BaseLayout>
